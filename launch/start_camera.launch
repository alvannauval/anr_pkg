<launch>
    <!-- Temporal Filter Settings -->
    <param name="/camera/temporal/holes_fill" value="7" type="int"/>

    <!-- Depth Sensor Settings - Manual Exposure and Medium Density -->
    <param name="/camera/stereo_module/visual_preset" value="5" type="int"/>
    <param name="/camera/stereo_module/enable_auto_exposure" value="false" type="bool"/>
    <param name="/camera/stereo_module/exposure" value="8500" type="int"/>
    <param name="/camera/stereo_module/gain" value="16" type="int"/>
    <param name="/camera/stereo_module/emitter_enabled" value="1" type="int"/>

    <!-- Color Sensor Settings (RGB Camera) -->
    <param name="/camera/rgb_camera/enable_auto_exposure" value="true" type="bool"/>
    <!-- Launch the RealSense camera with all your custom arguments -->
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="align_depth" value="true" />
        <arg name="filters" value="temporal" />
        <arg name="color_width" value="1280" />
        <arg name="color_height" value="720" />
        <arg name="depth_width" value="1280" />
        <arg name="depth_height" value="720" />
        <arg name="clip_distance" value="0.7" />
    </include>
</launch>
